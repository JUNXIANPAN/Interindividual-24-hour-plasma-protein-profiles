{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScientificResultManifest",
  "type": "object",
  "required": ["schema_version", "run_id", "job_id", "workflow_name", "status", "inputs", "outputs"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "job_id": {"type": "string"},
    "workflow_name": {"type": "string"},
    "status": {"enum": ["COMPLETED", "FAILED", "PARTIAL"]},
    "inputs": {"type": "array"},
    "outputs": {"type": "array"}
  },
  "additionalProperties": true
}
